#!/usr/bin/env bash
# Gate: pass must match live Grok (session_id, compaction_gen).
# compaction_gen = sha256 of compaction/segment_* listing (see orient-session.py).
# Not wall-clock TTL; not signals.compactionCount (that can lag).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS="$ROOT/.orient/pass"
MODE="${1:-status}"

if [[ "${ORIENT_SKIP:-}" == "1" ]]; then
  echo "orient-check: SKIPPED via ORIENT_SKIP=1" >&2
  exit 0
fi

if [[ ! -f "$PASS" ]]; then
  echo "orient-check: no pass — refuse" >&2
  echo "  When ready: bin/try-me && bin/prove-me …  (see ORIENT.md)" >&2
  exit 1
fi

# Live session state
live_json=$(python3 "$ROOT/bin/orient-session.py" 2>/dev/null) || {
  echo "orient-check: cannot resolve Grok session/compaction — refuse" >&2
  echo "  (no active session for this cwd, or session dir missing)" >&2
  exit 1
}

python3 - "$PASS" "$live_json" "$MODE" <<'PY'
import json, sys

pass_path, live_s, mode = sys.argv[1], sys.argv[2], sys.argv[3]
p = json.load(open(pass_path))
live = json.loads(live_s)
if not live.get("ok"):
    print(f"orient-check: session resolve failed: {live.get('error')}", file=sys.stderr)
    sys.exit(1)

ps, pg = p.get("session_id"), p.get("compaction_gen")
ls, lg = live.get("session_id"), live.get("compaction_gen")

if ps is None or pg is None:
    # pre-v5: TTL, uses_left, or signals.compactionCount binding
    print(
        "orient-check: pass is pre-segment-gen — re-run try-me / prove-me",
        file=sys.stderr,
    )
    sys.exit(1)

if ps != ls:
    print(
        f"orient-check: session changed (pass={ps[:8]}… live={ls[:8]}…) — re-prove",
        file=sys.stderr,
    )
    sys.exit(1)

if pg != lg:
    n = live.get("segment_count", "?")
    print(
        f"orient-check: context compacted "
        f"(segment listing changed; live segments={n}) — re-prove",
        file=sys.stderr,
    )
    sys.exit(1)

uses = p.get("uses_left", -1)
if uses is not None and uses != -1 and int(uses) < 1:
    print("orient-check: pass exhausted — re-prove", file=sys.stderr)
    sys.exit(1)

if mode in ("status", "verify-msg"):
    print(
        f"orient-check: ok "
        f"(session={ls[:8]}… gen={lg[:12]}… "
        f"segments={live.get('segment_count')} "
        f"provisional={p.get('provisional')})"
    )
    sys.exit(0)

print(f"orient-check: unknown mode {mode}", file=sys.stderr)
sys.exit(2)
PY
