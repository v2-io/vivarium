#!/usr/bin/env bash
# Gate: valid orientation pass (time window after prove-me).
# Used by pre-commit / commit-msg. No per-commit token — multi-commit + multi-
# compaction runs share one pass until it expires.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS="$ROOT/.orient/pass"
MODE="${1:-status}"

if [[ "${ORIENT_SKIP:-}" == "1" ]]; then
  echo "orient-check: SKIPPED via ORIENT_SKIP=1" >&2
  exit 0
fi

if [[ ! -f "$PASS" ]]; then
  echo "orient-check: no pass — refuse" >&2
  echo "  When ready: bin/try-me && bin/prove-me …  (see ORIENT.md)" >&2
  exit 1
fi

read_pass_field() {
  python3 -c "import json;p=json.load(open('$PASS'));print(p.get('$1',''))"
}

PASS_EXP=$(read_pass_field expires)
PASS_USES=$(read_pass_field uses_left)
PASS_PROV=$(read_pass_field provisional)
now=$(date +%s)

if [[ -z "$PASS_EXP" ]]; then
  echo "orient-check: malformed pass" >&2
  exit 1
fi
if (( now > PASS_EXP )); then
  echo "orient-check: pass expired — run bin/try-me && bin/prove-me again" >&2
  exit 1
fi
# uses_left: -1 or missing = unlimited until expires; 0 = spent (legacy one-shot)
if [[ -n "${PASS_USES}" && "${PASS_USES}" != "-1" && "${PASS_USES}" -lt 1 ]]; then
  echo "orient-check: pass exhausted — run bin/try-me && bin/prove-me again" >&2
  exit 1
fi

if [[ "$MODE" == "status" || "$MODE" == "verify-msg" ]]; then
  # verify-msg: no token required (v3); keep subcommand so hooks stay compatible
  echo "orient-check: ok (provisional=${PASS_PROV:-} expires_in=$((PASS_EXP-now))s)"
  exit 0
fi

echo "orient-check: unknown mode $MODE" >&2
exit 2
