#!/usr/bin/env bash
# Gate: commit message carries orient:<session_id>; that session's compaction
# generation must still match the pass written at prove-me.
#
# Joseph's sketch: whitelist session-id in the commit → find claude|grok →
# check compaction gen (not TTL, not cwd ownership).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ORIENT="$ROOT/.orient"
PASSES="$ORIENT/passes"
MODE="${1:-status}"

if [[ "${ORIENT_SKIP:-}" == "1" ]]; then
  echo "orient-check: SKIPPED via ORIENT_SKIP=1" >&2
  exit 0
fi

pass_path_for() {
  # $1 = session_id — mildly obscured stem (xor+hex), not the raw uuid
  python3 "$ROOT/bin/orient-session.py" --pass-path "$1"
}

case "$MODE" in
status)
  # Soft pre-commit: do not invent "current cwd owner". Report whether any
  # pass exists; real conviction is verify-msg on the commit.
  if [[ ! -d "$PASSES" ]] || [[ -z "$(ls -A "$PASSES" 2>/dev/null || true)" ]]; then
    # legacy single pass file
    if [[ -f "$ORIENT/pass" ]]; then
      echo "orient-check: legacy .orient/pass present (pre multi-session) — re-prove for orient:<session_id>" >&2
      exit 1
    fi
    echo "orient-check: no pass — refuse" >&2
    echo "  When ready: bin/try-me && bin/prove-me …  (see ORIENT.md)" >&2
    echo "  Commit message must include orient:<session_id from prove-me>" >&2
    exit 1
  fi
  echo "orient-check: pass(es) on disk under .orient/passes/ — commit needs orient:<session_id>"
  exit 0
  ;;

verify-msg)
  msgfile="${2:-}"
  if [[ -z "$msgfile" || ! -f "$msgfile" ]]; then
    echo "orient-check: missing commit message file" >&2
    echo "  hooks/commit-msg must pass \$1: bin/orient-check verify-msg \"\$1\"" >&2
    exit 1
  fi

  # Accept UUID (Grok/Claude style) after orient:
  sid=$(grep -oE 'orient:[0-9a-fA-F-]{8,}' "$msgfile" | head -1 | sed 's/^orient://' || true)
  if [[ -z "$sid" ]]; then
    echo "orient-check: commit message must contain orient:<session_id from prove-me>" >&2
    exit 1
  fi

  live_json=$(python3 "$ROOT/bin/orient-session.py" --id "$sid" 2>/dev/null) || {
    echo "orient-check: cannot resolve session $sid under ~/.grok or ~/.claude — refuse" >&2
    exit 1
  }

  python3 - "$ROOT" "$live_json" "$sid" <<'PY'
import importlib.util, json, sys
from pathlib import Path

root, live_s, sid = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
live = json.loads(live_s)
if not live.get("ok"):
    print(f"orient-check: session resolve failed: {live.get('error')}", file=sys.stderr)
    sys.exit(1)

spec = importlib.util.spec_from_file_location(
    "orient_crypto", root / "bin" / "orient-crypto.py"
)
assert spec and spec.loader
crypto = importlib.util.module_from_spec(spec)
spec.loader.exec_module(crypto)

try:
    p = crypto.read_pass(sid, root)
except FileNotFoundError:
    print(
        f"orient-check: no pass for session {sid[:8]}… — run try-me / prove-me",
        file=sys.stderr,
    )
    sys.exit(1)
except ValueError as e:
    print(f"orient-check: pass unreadable ({e}) — re-prove", file=sys.stderr)
    sys.exit(1)

ps, pg = p.get("session_id"), p.get("compaction_gen")
ls, lg = live.get("session_id"), live.get("compaction_gen")
lh = live.get("harness")

if ps is None or pg is None:
    print(
        "orient-check: pass is pre-gen — re-run try-me / prove-me",
        file=sys.stderr,
    )
    sys.exit(1)

if ps != sid or ls != sid:
    print(
        f"orient-check: session mismatch (token={sid[:8]}… pass={str(ps)[:8]}… live={str(ls)[:8]}…)",
        file=sys.stderr,
    )
    sys.exit(1)

if pg != lg:
    n = live.get("boundary_count", "?")
    print(
        f"orient-check: context compacted "
        f"(harness={lh}; generation changed; boundaries={n}) — re-prove",
        file=sys.stderr,
    )
    sys.exit(1)

print(
    f"orient-check: ok "
    f"(harness={lh} session={sid[:8]}… gen={lg[:12]}… "
    f"boundaries={live.get('boundary_count')} "
    f"provisional={p.get('provisional')})"
)
sys.exit(0)
PY
  ;;

*)
  echo "orient-check: unknown mode $MODE (status|verify-msg)" >&2
  exit 2
  ;;
esac
