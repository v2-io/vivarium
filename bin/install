#!/usr/bin/env bash
# Put `vivarium` and `vivarium-explore` on your PATH as real commands, so a session is `vivarium build &` and `vivarium explore` rather
# than a cargo incantation typed from the repo root.
#
# `vivarium explore` dispatches by exec to `vivarium-explore`, so the two want to
# be installed together (the CLI looks for a sibling of itself first, then PATH).
#
# Installs to ~/.cargo/bin (already on PATH here — it is where fmt-md lives).
# Re-run after changing any of them; cargo rebuilds only what moved.
#
#   bin/install                    # both
#   bin/install vivarium           # just the CLI (fast — no bevy)
set -euo pipefail
cd "$(dirname "$0")/.."

want() { [ $# -eq 0 ] || printf '%s\n' "$@" | grep -qx "$1"; }

if want vivarium "$@"; then
  echo "== vivarium (CLI) =="
  cargo install --path crates/vivarium-world --bin vivarium --locked
fi
if want vivarium-explore "$@"; then
  echo "== vivarium-explore (the 3D explorer; bevy -- slow first build) =="
  cargo install --path crates/vivarium-explore --locked
fi

echo
echo "installed:"
for b in vivarium vivarium-explore; do
  printf '  %-22s %s\n' "$b" "$(command -v "$b" || echo '(not on PATH)')"
done
