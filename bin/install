#!/usr/bin/env bash
# Put `vivarium`, `vivarium-globe` and `vivarium-worldview` on your PATH as real
# commands, so a session is `vivarium build &` and `vivarium-globe` rather than a
# cargo incantation typed from the repo root.
#
# Installs to ~/.cargo/bin (already on PATH here — it is where fmt-md lives).
# Re-run after changing any of them; cargo rebuilds only what moved.
#
#   bin/install            # all three
#   bin/install vivarium   # just the CLI (fast — no bevy)
set -euo pipefail
cd "$(dirname "$0")/.."

want() { [ $# -eq 0 ] || printf '%s\n' "$@" | grep -qx "$1"; }

if want vivarium "$@"; then
  echo "== vivarium (CLI) =="
  cargo install --path crates/vivarium-world --bin vivarium --locked
fi
if want vivarium-globe "$@"; then
  echo "== vivarium-globe (bevy — slow first build) =="
  cargo install --path spikes/globe --locked
fi
if want vivarium-worldview "$@"; then
  echo "== vivarium-worldview (bevy) =="
  cargo install --path spikes/worldview --locked
fi

echo
echo "installed:"
for b in vivarium vivarium-globe vivarium-worldview; do
  printf '  %-22s %s\n' "$b" "$(command -v "$b" || echo '(not on PATH)')"
done
