#!/usr/bin/env bash
# Closed-book orientation prove.
#
# Required Level-A files are made unreadable BEFORE questions are printed, so
# a tool cannot open them between Q and A. Answers are checked as SHA-256 of
# normalized text; plaintext keys are not in the repo (bin/orient-quiz.sha).
set -euo pipefail
if [[ -z "${BASH_VERSION:-}" ]]; then
  echo "orient-prove: must run under bash" >&2
  exit 1
fi
# shellcheck source=orient-lib.sh
source "$(cd "$(dirname "$0")" && pwd)/orient-lib.sh"

if [[ "${ORIENT_SKIP:-}" == "1" ]]; then
  echo "orient-prove: ORIENT_SKIP=1 — not for agents" >&2
  exit 0
fi

[[ -f "$QUIZ_FILE" ]] || orient_die "missing $QUIZ_FILE"
[[ -f "$STUDY_FILE" ]] || orient_die "no study commitment — run: bin/orient-study (after reading Level A)"

study_ts=$(grep '^ts=' "$STUDY_FILE" | head -1 | cut -d= -f2)
study_corpus=$(grep '^corpus=' "$STUDY_FILE" | head -1 | cut -d= -f2)
[[ -n "$study_ts" && -n "$study_corpus" ]] || orient_die "malformed $STUDY_FILE"
now=$(date +%s)
age=$((now - study_ts))
if (( age > STUDY_TTL_SEC || age < 0 )); then
  orient_die "study expired (${age}s old; TTL ${STUDY_TTL_SEC}s) — re-read Level A and bin/orient-study"
fi
live=$(orient_corpus_hash)
if [[ "$live" != "$study_corpus" ]]; then
  orient_die "Level-A corpus changed since study (study=$study_corpus live=$live) — re-read and bin/orient-study"
fi
while IFS= read -r line; do
  [[ "$line" == *"="* ]] || continue
  p=${line%%=*}
  want=${line#*=}
  f="$ORIENT_ROOT/$p"
  got=$(orient_sha_file "$f")
  [[ "$got" == "$want" ]] || orient_die "digest drift on $p — re-study"
done < <(sed -n '/^files<</,/^>>/p' "$STUDY_FILE" | sed '1d;$d')

# Load quiz into parallel arrays BEFORE seal (quiz file is not sealed)
QIDS=()
QTEXTS=()
QHASHES=()
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ "$line" =~ ^# ]] && continue
  [[ -z "$line" ]] && continue
  IFS='|' read -r qid hashes qtext <<<"$line"
  [[ -n "${qid:-}" && -n "${hashes:-}" && -n "${qtext:-}" ]] || continue
  QIDS+=("$qid")
  QTEXTS+=("$qtext")
  QHASHES+=("$hashes")
done <"$QUIZ_FILE"
n=${#QIDS[@]}
(( n > 0 )) || orient_die "empty quiz"

# --- seal BEFORE any question text ---
trap 'orient_unseal' EXIT INT TERM
orient_seal
echo "orient-prove: sealed Level-A paths (unreadable until this process exits)" >&2
echo "orient-prove: closed-book — answers must already be in working memory" >&2
echo >&2

echo "===== ORIENT PROVE (closed-book; $n questions) ====="
echo "Answer format: one line per question as  ${QIDS[0]}: <answer text>"
echo "All answers in one paste, then EOF. Order free."
echo

for i in "${!QIDS[@]}"; do
  echo "${QIDS[$i]}. ${QTEXTS[$i]}"
  echo
done

echo "----- answers below this line -----"

GIVEN_IDS=()
GIVEN_ANS=()
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" ]] && continue
  if [[ "$line" =~ ^([Qq][0-9]+)[[:space:]]*:[[:space:]]*(.*)$ ]]; then
    GIVEN_IDS+=("$(echo "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')")
    GIVEN_ANS+=("${BASH_REMATCH[2]}")
  fi
done

orient_unseal
trap - EXIT INT TERM

lookup_answer() {
  local want="$1" i
  for i in "${!GIVEN_IDS[@]}"; do
    if [[ "${GIVEN_IDS[$i]}" == "$want" ]]; then
      printf '%s' "${GIVEN_ANS[$i]}"
      return 0
    fi
  done
  return 1
}

fail=0
for i in "${!QIDS[@]}"; do
  qid="${QIDS[$i]}"
  if ! ans=$(lookup_answer "$qid"); then
    echo "orient-prove: FAIL $qid — no answer" >&2
    fail=$((fail + 1))
    continue
  fi
  got=$(printf '%s' "$ans" | orient_norm | {
    if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi
  } | awk '{print $1}')
  ok=0
  IFS=',' read -ra hs <<<"${QHASHES[$i]}"
  for hx in "${hs[@]}"; do
    [[ "$got" == "$hx" ]] && ok=1 && break
  done
  if (( ok == 0 )); then
    echo "orient-prove: FAIL $qid — answer hash mismatch" >&2
    fail=$((fail + 1))
  else
    echo "orient-prove: ok   $qid"
  fi
done

if (( fail > 0 )); then
  echo "orient-prove: $fail failure(s). Re-read Level A fully, bin/orient-study, then prove again." >&2
  exit 1
fi

mkdir -p "$ORIENT_DIR"
pass_ts=$(date +%s)
pass_token=$(orient_sha_str "${live}:${pass_ts}:${study_ts}:orient-pass-v1")
{
  echo "version=1"
  echo "ts=$pass_ts"
  echo "corpus=$live"
  echo "study_ts=$study_ts"
  echo "token=$pass_token"
} >"$PASS_FILE"

echo
echo "orient-prove: PASS corpus=$live"
echo "orient-prove: commit window ${PASS_TTL_SEC}s — then re-prove"
