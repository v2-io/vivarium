#!/usr/bin/env python3
"""
Generate a closed-book orientation test from random segment paragraphs.

Protocol (ORIENT.md):
  1. Read freely while core/src is open.
  2. bin/try-me  — samples paragraphs, SEALS core/src, writes .orient/test.jsonl
  3. bin/prove-me — grade answers; grants a multi-hour commit pass
  4. git commit (hooks check the pass has not expired)

Randomness: os.urandom / SystemRandom (not hash of clock alone).
"""
from __future__ import annotations

import hashlib
import json
import os
import random
import re
import stat
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ORIENT = ROOT / ".orient"
TEST_PATH = ORIENT / "test.jsonl"
BURNED = ORIENT / "burned"
SEAL_LIST = ORIENT / "sealed_paths"
SAMPLE_N = int(os.environ.get("ORIENT_SAMPLE_N", "12"))
# Time to finish the quiz after try-me — not the commit-access window.
TEST_TTL = int(os.environ.get("ORIENT_TEST_TTL_SEC", "1800"))  # 30m
PREFIX_WORDS = int(os.environ.get("ORIENT_PREFIX_WORDS", "6"))


def die(msg: str, code: int = 1) -> None:
    print(f"try-me: {msg}", file=sys.stderr)
    sys.exit(code)


def sha256_text(s: str) -> str:
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def normalize(s: str) -> str:
    s = s.strip().lower()
    s = re.sub(r"\s+", " ", s)
    s = re.sub(r"[^\w\s]", "", s)  # strip punctuation
    return s.strip()


def git_head() -> str:
    try:
        return (
            subprocess.check_output(
                ["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
                stderr=subprocess.DEVNULL,
            )
            .decode()
            .strip()
        )
    except Exception:
        return "nogit"


def outline_titles() -> dict[str, str]:
    """slug → plain title from OUTLINE.md links when available."""
    out: dict[str, str] = {}
    outline = ROOT / "core" / "OUTLINE.md"
    if not outline.is_file():
        return out
    # [#slug](src/slug.md) | Claim text
    for line in outline.read_text(encoding="utf-8", errors="replace").splitlines():
        m = re.search(r"\[#([a-z0-9-]+)\]\([^)]+\)\s*\|\s*([^|]+)", line)
        if m:
            out[m.group(1)] = m.group(2).strip()
    return out


def parse_segment(path: Path) -> list[dict]:
    """Return candidate paragraphs with breadcrumb context."""
    text = path.read_text(encoding="utf-8", errors="replace")
    rel = str(path.relative_to(ROOT))
    slug = path.stem
    # frontmatter title = first H1 after fm
    lines = text.splitlines()
    i = 0
    if lines and lines[0].strip() == "---":
        i = 1
        while i < len(lines) and lines[i].strip() != "---":
            i += 1
        i += 1
    h1 = h2 = h3 = ""
    # join into paragraphs (blank-line separated), track headings
    paras: list[dict] = []
    buf: list[str] = []
    heads = ("", "", "")

    def flush():
        nonlocal buf, heads
        if not buf:
            return
        para = "\n".join(buf).strip()
        buf = []
        if len(para) < 80 or len(para) > 1200:
            return
        # skip pure code / tables-ish
        if para.startswith("```") or para.startswith("|"):
            return
        if para.startswith("#"):
            return
        words = para.split()
        if len(words) < 12:
            return
        crumb = " > ".join(x for x in heads if x)
        paras.append(
            {
                "path": rel,
                "slug": slug,
                "breadcrumb": crumb or slug,
                "paragraph": para,
            }
        )

    for line in lines[i:]:
        if line.startswith("# "):
            flush()
            heads = (line[2:].strip(), "", "")
            continue
        if line.startswith("## "):
            flush()
            heads = (heads[0], line[3:].strip(), "")
            continue
        if line.startswith("### "):
            flush()
            heads = (heads[0], heads[1], line[4:].strip())
            continue
        if not line.strip():
            flush()
            continue
        buf.append(line)
    flush()
    return paras


def collect_pool() -> list[dict]:
    src = ROOT / "core" / "src"
    if not src.is_dir():
        die(f"missing {src}")
    pool: list[dict] = []
    for p in sorted(src.rglob("*.md")):
        pool.extend(parse_segment(p))
    return pool


def seal_core_src() -> int:
    ORIENT.mkdir(parents=True, exist_ok=True)
    paths = sorted((ROOT / "core" / "src").rglob("*.md"))
    SEAL_LIST.write_text("\n".join(str(p) for p in paths) + "\n", encoding="utf-8")
    n = 0
    for p in paths:
        mode = p.stat().st_mode
        p.chmod(mode & ~stat.S_IRUSR & ~stat.S_IRGRP & ~stat.S_IROTH)
        n += 1
    return n


def unseal_core_src() -> None:
    if not SEAL_LIST.is_file():
        return
    for line in SEAL_LIST.read_text(encoding="utf-8").splitlines():
        p = Path(line)
        if p.exists():
            try:
                p.chmod(0o644)
            except OSError:
                pass
    SEAL_LIST.unlink(missing_ok=True)


def main() -> None:
    print(
        "try-me: Orientation check. Run this when you believe you are ready to commit.\n",
        file=sys.stderr,
    )

    rng = random.SystemRandom()  # os.urandom-backed
    pool = collect_pool()
    if len(pool) < SAMPLE_N:
        die(f"not enough paragraphs in core/src ({len(pool)} < {SAMPLE_N})")

    # without replacement
    samples = rng.sample(pool, SAMPLE_N)
    titles = outline_titles()
    now = int(time.time())
    head = git_head()
    test_id = sha256_text(f"{now}:{head}:{os.urandom(16).hex()}")[:16]

    # burn check
    burned = set()
    if BURNED.is_file():
        burned = {ln.strip() for ln in BURNED.read_text().splitlines() if ln.strip()}

    items = []
    for idx, s in enumerate(samples):
        words = s["paragraph"].split()
        prefix_n = min(PREFIX_WORDS, max(3, len(words) // 4))
        prefix = " ".join(words[:prefix_n])
        rest = " ".join(words[prefix_n:])
        # stochastic: include outline title ~40%
        show_title = rng.random() < 0.4
        title = titles.get(s["slug"], "") if show_title else ""
        # stochastic: also give last word as end-anchor ~30%
        give_last = rng.random() < 0.3 and len(words) > prefix_n + 2
        last_word = words[-1] if give_last else ""
        answer_norm = normalize(rest)
        items.append(
            {
                "id": f"P{idx+1}",
                "path": s["path"],
                "slug": s["slug"],
                "breadcrumb": s["breadcrumb"],
                "title_hint": title,
                "prefix": prefix,
                "last_word_hint": last_word,
                "answer_sha256": sha256_text(answer_norm),
                # also accept full paragraph normalized (honest format confusion)
                "answer_sha256_full": sha256_text(normalize(s["paragraph"])),
                "answer_sha256_prefix_rest": sha256_text(normalize(prefix + " " + rest)),
            }
        )

    deadline = now + TEST_TTL
    # salt discoverable in script — raises effort slightly; not a security boundary
    salt = "vivarium-orient-v2"
    mac = sha256_text(f"{salt}:{test_id}:{deadline}:{head}")

    doc = {
        "version": 2,
        "test_id": test_id,
        "created": now,
        "deadline": deadline,
        "git_head": head,
        "mac": mac,
        "n": SAMPLE_N,
        "instructions": (
            "Each item: continue the paragraph after `prefix` through the end of that "
            "paragraph (same sense as the segment text). Normalize does not matter for "
            "typing; prove-me lowercases, collapses space, strips punctuation. "
            "If last_word_hint is set, your completion should end with that word."
        ),
        "items": items,
    }

    # SEAL after sampling (we already have paragraph text in memory)
    try:
        n_sealed = seal_core_src()
    except Exception as e:
        unseal_core_src()
        die(f"seal failed: {e}")

    ORIENT.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(doc, indent=2, ensure_ascii=False) + "\n"
    TEST_PATH.write_text(payload, encoding="utf-8")

    print(f"try-me: test_id={test_id}  items={SAMPLE_N}  sealed_files={n_sealed}", file=sys.stderr)
    print(f"try-me: wrote {TEST_PATH}", file=sys.stderr)
    print(f"try-me: deadline in {TEST_TTL}s (unix {deadline})", file=sys.stderr)
    print("try-me: when finished answering, run:  bin/prove-me answers.txt", file=sys.stderr)
    print(file=sys.stderr)
    # human-readable prompt on stdout
    print(json.dumps({"test_id": test_id, "path": str(TEST_PATH), "deadline": deadline}, indent=2))
    print()
    for it in items:
        print(f"=== {it['id']} ===")
        print(f"breadcrumb: {it['breadcrumb']}")
        if it["title_hint"]:
            print(f"outline title: {it['title_hint']}")
        print(f"slug: {it['slug']}")
        print(f"prefix: {it['prefix']} …")
        if it["last_word_hint"]:
            print(f"(completion should end with: {it['last_word_hint']})")
        print()


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        unseal_core_src()
        sys.exit(0)
    except Exception:
        unseal_core_src()
        raise
