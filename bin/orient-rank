#!/usr/bin/env python3
"""Orientation hotlist: multi-factor segment importance ranking.

v0 purpose
----------
Make the orient gate *tractable*: a dynamic, explainable ranking that
(1) agents can free-read in score order under a token budget, and
(2) `bin/try-me` can use as a sampling distribution (softmax).

This is deliberately imperfect. Equal-weight CDF-normalized factors are
good enough to move with confidence; rebalance when we have evidence.

Factors (each mapped to ~U(0,1) via rank-CDF, then combined)
------------------------------------------------------------
  freshness       file mtime (unix)
  hotness_churn   path touches among the last GIT_WINDOW commits (default 100)
  hotness_mention #slug / slug in messages among those same commits
  preeminence     transitive dependent count on depends: DAG
  working_surface Working Notes present × file mtime (molten residue)
  pagerank        PageRank on soft #slug mention graph (in-body)

Aggregate: **geometric mean** of rank-CDF factors (high-is-good, already in
(0,1) so no exact-zero annihilation). Bottleneck: a weak axis pulls the
score down harder than arithmetic mean would. Type prior multiplies *after*
the GM, not inside it.

**Tip fiat (post-GM):** up to TIP_TOP_N segments changed or mentioned in the
last TIP_COMMITS commits (ordered by most recent hit, then hit count, then
mtime) are forced to ranks **1..k**. Remaining segments keep their relative
GM order starting at rank **k+1**. Tip rows get scores strictly above every
non-tip so free-read and try-me (score^α) both see the same order.

Git hotness (factor) is a **rolling commit window** (default last 100 commits
on HEAD), separate from the tip fiat window (default last 30).

Polished-version notes are inline (cache/memo, EMA as alternative to window, etc.).

Usage
-----
  bin/orient-rank              # human table on stdout
  bin/orient-rank --json       # machine JSON (also written to .orient/hotlist.json)
  bin/orient-rank --top 20
  bin/orient-rank --scores-only  # slug\\tscore lines for try-me
  bin/orient-rank --mark-outline [--top N]
      # Star the top-N (default 25) ranked segments *in OUTLINE order*
      # (★ before [#slug]). Agents free-read by outline order, not rank order.

Exit 0 always if ranking succeeds; ranking failure should be loud.
"""
from __future__ import annotations

import argparse
import json
import math
import os
import re
import subprocess
import sys
import time
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "core" / "src"
OUTLINE = ROOT / "core" / "OUTLINE.md"
HOTLIST_PATH = ROOT / ".orient" / "hotlist.json"

# Rolling window for all git-derived hotness (churn + mention): last N commits
# on HEAD (not wall-clock). Override: ORIENT_GIT_WINDOW_COMMITS or --git-window-commits.
# Polished: EMA half-life as alternative; wall-clock window as option.
DEFAULT_GIT_WINDOW_COMMITS = 100
# Softmax temperature for try-me (exported via JSON; try-me may override).
# Lower T → peakier on top ranks; higher → closer to uniform.
DEFAULT_SOFTMAX_T = 0.35

# Tip fiat: last N commits → top K segments pin ranks 1..K (see apply_tip_fiat).
# Shared knobs with try-me (env overrides).
TIP_COMMITS = int(os.environ.get("ORIENT_TIP_COMMITS", "30"))
TIP_TOP_N = int(os.environ.get("ORIENT_TIP_TOP_N", "6"))
# Scores for fiat tip ranks sit above all GM scores (which clamp ≤1.5).
TIP_FIAT_SCORE_TOP = 1.50
TIP_FIAT_SCORE_STEP = 0.02

# Type prior multipliers applied *after* equal-weight mean (gentle v0).
# Polished: learn from prove free-read / commit citation data.
TYPE_PRIOR = {
    "scope": 1.12,
    "normative": 1.12,
    "postulate": 1.10,
    "definition": 1.08,
    "formulation": 1.05,
    "observation": 1.05,
    "detail": 1.00,
    "worked-example": 0.95,
    "discussion": 0.90,
    "sketch": 0.85,
    "ops": 1.00,
}


# ── parsing ───────────────────────────────────────────────────────────────────


def parse_frontmatter(text: str) -> dict:
    meta: dict = {"depends": [], "type": "", "status": "", "slug": ""}
    if not text.startswith("---"):
        return meta
    m = re.match(r"^---\n(.*?)\n---\n?", text, re.S)
    if not m:
        return meta
    block = m.group(1)
    key = None
    for line in block.splitlines():
        if re.match(r"^[a-zA-Z0-9_-]+:", line):
            k, _, v = line.partition(":")
            key = k.strip()
            v = v.strip()
            if key == "depends":
                meta["depends"] = []
                if v and v not in ("", "[]"):
                    # inline list rare
                    pass
            elif key in meta:
                meta[key] = v
            else:
                meta[key] = v
        elif key == "depends" and line.strip().startswith("-"):
            dep = line.strip().lstrip("-").strip()
            if dep:
                meta["depends"].append(dep)
    return meta


def has_working_notes(text: str) -> bool:
    return bool(re.search(r"(?m)^## Working Notes\s*$", text))


def extract_slug_mentions(text: str, known: set[str]) -> set[str]:
    """Soft graph edges: #slug and bare slug in markdown links to src/slug.md."""
    found: set[str] = set()
    for m in re.finditer(r"#([a-z0-9][a-z0-9-]{2,})", text):
        s = m.group(1)
        if s in known:
            found.add(s)
    for m in re.finditer(r"src/([a-z0-9][a-z0-9-]{2,})\.md", text):
        s = m.group(1)
        if s in known:
            found.add(s)
    return found


def load_segments() -> dict[str, dict]:
    """slug -> record with path, meta, text, mtime, …"""
    segs: dict[str, dict] = {}
    if not SRC.is_dir():
        print("orient-rank: missing core/src", file=sys.stderr)
        sys.exit(2)
    for p in sorted(SRC.glob("*.md")):
        text = p.read_text(encoding="utf-8", errors="replace")
        meta = parse_frontmatter(text)
        slug = meta.get("slug") or p.stem
        st = p.stat()
        segs[slug] = {
            "slug": slug,
            "path": p,
            "rel": str(p.relative_to(ROOT)),
            "type": (meta.get("type") or "").strip(),
            "status": (meta.get("status") or "").strip(),
            "depends": list(meta.get("depends") or []),
            "text": text,
            "mtime": st.st_mtime,
            "size": st.st_size,
            "has_wn": has_working_notes(text),
        }
    return segs


# ── git factors ───────────────────────────────────────────────────────────────


def git_available() -> bool:
    try:
        subprocess.check_output(
            ["git", "-C", str(ROOT), "rev-parse", "--git-dir"],
            stderr=subprocess.DEVNULL,
        )
        return True
    except Exception:
        return False


def load_git_window(window_commits: int = DEFAULT_GIT_WINDOW_COMMITS) -> dict:
    """One walk: last N commits → path churn + message mention counts.

    Returns {
      "n_commits": int,           # |window| (may be < N on young repos)
      "churn": {rel_path: count},
      "mention": {slug_or_token: count},  # raw substrings we care about later
      "messages": [str, ...],     # subject+body per commit (for slug scan)
    }

    "Within the last N commits" means among the N newest commits reachable
    from HEAD — not "N path-touching commits" and not wall-clock.

    Polished: memoize under .orient/cache/git-window-{HEAD}-{N}.json;
    include PR titles; tokenize #slugs once into a Counter.
    """
    empty = {"n_commits": 0, "churn": {}, "mention": {}, "messages": []}
    if not git_available():
        return empty
    n = max(1, int(window_commits))
    try:
        # %H full hash; %s subject; %b body; name-only paths after blank line
        # Use a record separator so we can split commits reliably.
        out = subprocess.check_output(
            [
                "git",
                "-C",
                str(ROOT),
                "log",
                f"-n{n}",
                "--name-only",
                "--pretty=format:%x1e%H%x00%s%x00%b%x00",
                "HEAD",
            ],
            stderr=subprocess.DEVNULL,
            text=True,
            errors="replace",
        )
    except Exception:
        return empty

    churn: dict[str, int] = defaultdict(int)
    messages: list[str] = []
    # records start with \x1e
    for rec in out.split("\x1e"):
        rec = rec.strip("\n")
        if not rec:
            continue
        # first line-ish: hash\0subject\0body\0 then paths
        null_parts = rec.split("\x00")
        if len(null_parts) < 3:
            continue
        _hash, subject, body = null_parts[0], null_parts[1], null_parts[2]
        rest = null_parts[3] if len(null_parts) > 3 else ""
        # paths may be in rest after body, or after extra newlines in body split
        # pretty=format ends body with \0 then name-only lines follow before next \x1e
        # Actually format is: \x1e%H\0%s\0%b\0 then name-only adds paths with newlines
        # So rec = "%H\0%s\0%b\0\npath1\npath2\n"
        msg = f"{subject}\n{body}"
        messages.append(msg)
        # paths: everything after the third \0
        path_blob = rec.split("\x00", 3)
        paths_text = path_blob[3] if len(path_blob) > 3 else ""
        for line in paths_text.splitlines():
            line = line.strip()
            if line and not line.startswith("\x1e"):
                churn[line] += 1

    return {
        "n_commits": len(messages),
        "churn": dict(churn),
        "messages": messages,
    }


def git_commits_touching(rel: str, window: dict) -> int:
    """Path churn inside the preloaded commit window."""
    return int(window.get("churn", {}).get(rel, 0))


def git_mention_count(slug: str, window: dict) -> int:
    """Message mentions of #slug or slug inside the preloaded window."""
    n = 0
    slug_l = slug.lower()
    tag = f"#{slug_l}"
    for msg in window.get("messages", []):
        m = msg.lower()
        if tag in m or slug_l in m:
            n += 1
    return n


# ── graph factors ─────────────────────────────────────────────────────────────


def build_dependents(segs: dict[str, dict]) -> dict[str, set[str]]:
    """Invert depends: dep → set of segments that list dep."""
    dependents: dict[str, set[str]] = defaultdict(set)
    for slug, rec in segs.items():
        for d in rec["depends"]:
            if d in segs:
                dependents[d].add(slug)
            # unknown dep: ignore (broken link); polished: surface as rank debt
    return dependents


def transitive_dependent_count(
    slug: str, dependents: dict[str, set[str]], memo: dict[str, int]
) -> int:
    """|{ S | slug is a proper ancestor of S on depends-inverted graph }|.

    Polished: full memoized DFS/topo once per graph version; store
    reachability bitsets for O(1) queries when segment count grows.
    """
    if slug in memo:
        return memo[slug]
    seen: set[str] = set()
    stack = list(dependents.get(slug, ()))
    while stack:
        n = stack.pop()
        if n in seen or n == slug:
            continue
        seen.add(n)
        stack.extend(dependents.get(n, ()))
    memo[slug] = len(seen)
    return memo[slug]


def build_mention_graph(segs: dict[str, dict]) -> dict[str, set[str]]:
    """Soft edges: slug → mentioned slugs (outgoing).

    Polished: weight edges by section (FE > ES > Discussion > WN);
    ignore self-links in frontmatter-only; cache adjacency keyed by
    content hash of each file.
    """
    known = set(segs)
    graph: dict[str, set[str]] = {}
    for slug, rec in segs.items():
        mentions = extract_slug_mentions(rec["text"], known)
        mentions.discard(slug)
        graph[slug] = mentions
    return graph


def pagerank(
    graph: dict[str, set[str]],
    *,
    damping: float = 0.85,
    iters: int = 40,
) -> dict[str, float]:
    """Classic PageRank on the soft mention graph.

    Polished:
      - Power iteration with residual stop; or use networkx once if we
        accept the dep (we don't for v0).
      - Separate PageRank on depends-inverted graph vs mention graph;
        blend with a learned or declared weight.
      - Memoize vector at HEAD + corpus hash.
    """
    nodes = list(graph.keys())
    if not nodes:
        return {}
    n = len(nodes)
    # inbound
    inbound: dict[str, list[str]] = {u: [] for u in nodes}
    outdeg: dict[str, int] = {}
    for u in nodes:
        outs = [v for v in graph[u] if v in graph]
        outdeg[u] = len(outs) or 1  # dangling handled via teleport
        for v in outs:
            inbound[v].append(u)

    pr = {u: 1.0 / n for u in nodes}
    for _ in range(iters):
        new = {}
        sink = sum(pr[u] for u in nodes if outdeg[u] == 0 or not graph[u])
        # simpler: always use outdeg at least 1 above
        for u in nodes:
            s = (1.0 - damping) / n
            for v in inbound[u]:
                s += damping * pr[v] / outdeg[v]
            new[u] = s
        # renormalize
        z = sum(new.values()) or 1.0
        pr = {u: new[u] / z for u in nodes}
    return pr


# ── normalization & score ─────────────────────────────────────────────────────


def rank_cdf(values: dict[str, float]) -> dict[str, float]:
    """Map raw scores → (rank + 0.5) / N ∈ (0,1). Ties share average rank.

    Preferable to min-max on heavy-tailed factors (PageRank, dependents).
    Polished: optional Gaussianize / log1p before rank for diagnostics.
    """
    if not values:
        return {}
    items = sorted(values.items(), key=lambda kv: kv[1])
    n = len(items)
    # average ranks for ties
    out: dict[str, float] = {}
    i = 0
    while i < n:
        j = i
        while j < n and items[j][1] == items[i][1]:
            j += 1
        avg_rank = (i + j - 1) / 2.0  # 0-based
        for k in range(i, j):
            out[items[k][0]] = (avg_rank + 0.5) / n
        i = j
    return out


def compute_scores(
    segs: dict[str, dict], *, window_commits: int = DEFAULT_GIT_WINDOW_COMMITS
) -> list[dict]:
    """Return list of {slug, score, factors_raw, factors_norm, …} sorted desc."""
    slugs = list(segs.keys())

    # ── raw factors ──────────────────────────────────────────────────────
    raw_fresh = {s: segs[s]["mtime"] for s in slugs}

    # One git walk for the tip window (not N×rev-list).
    window = load_git_window(window_commits)
    raw_churn: dict[str, float] = {
        s: float(git_commits_touching(segs[s]["rel"], window)) for s in slugs
    }
    raw_mention: dict[str, float] = {
        s: float(git_mention_count(s, window)) for s in slugs
    }

    dependents = build_dependents(segs)
    dep_memo: dict[str, int] = {}
    raw_pre: dict[str, float] = {
        s: float(transitive_dependent_count(s, dependents, dep_memo)) for s in slugs
    }

    # working surface: 0 if no WN; else mtime (molten residue proxy)
    # Polished: git log -L for ## Working Notes only; or blame newest WN line.
    raw_wn: dict[str, float] = {
        s: (segs[s]["mtime"] if segs[s]["has_wn"] else 0.0) for s in slugs
    }

    mention_graph = build_mention_graph(segs)
    raw_pr = pagerank(mention_graph)

    # session_prominence: NOT IMPLEMENTED in v0
    # Polished sketch:
    #   for each finished session under ~/.grok/sessions and ~/.claude/projects:
    #     scan tool args / chat for #slug; refs_per_kturn = refs / max(1, turns/1000)
    #     maintain EMA_s = α * refs_per_kturn + (1-α) * EMA_s
    #   cache per session_id processed → .orient/cache/session-prominence.json
    #   unit is per-kilo-turn so short one-offs don't dominate wall-clock
    raw_session = {s: 0.0 for s in slugs}  # placeholder zeros in diagnostics only

    factors = {
        "freshness": raw_fresh,
        "hotness_churn": raw_churn,
        "hotness_mention": raw_mention,
        "preeminence": raw_pre,
        "working_surface": raw_wn,
        "pagerank": raw_pr,
        # "session_prominence": raw_session,  # enable when implemented
    }

    norms = {name: rank_cdf(vals) for name, vals in factors.items()}
    factor_names = list(factors.keys())

    rows = []
    for s in slugs:
        parts = [norms[f][s] for f in factor_names]
        # Geometric mean of high-is-good rank-CDF factors (∈ (0,1)).
        # Bottleneck aggregator: weak axes pull harder than arithmetic mean.
        # Rank-CDF never hits exact 0, so GM does not annihilate on a zero.
        if parts:
            base = math.exp(sum(math.log(max(p, 1e-15)) for p in parts) / len(parts))
        else:
            base = 0.0
        prior = TYPE_PRIOR.get(segs[s]["type"], 1.0)
        score = base * prior
        # clamp for display stability
        score = max(0.0, min(1.5, score))
        rows.append(
            {
                "slug": s,
                "type": segs[s]["type"],
                "status": segs[s]["status"],
                "score": round(score, 6),
                "base": round(base, 6),
                "type_prior": prior,
                "aggregate": "geometric_mean",
                "has_working_notes": segs[s]["has_wn"],
                "factors_norm": {f: round(norms[f][s], 4) for f in factor_names},
                "factors_raw": {
                    "freshness_mtime": raw_fresh[s],
                    "hotness_churn": raw_churn[s],
                    "hotness_mention": raw_mention[s],
                    "hotness_window_commits": window.get("n_commits", 0),
                    "hotness_window_requested": window_commits,
                    "preeminence_dependents": raw_pre[s],
                    "working_surface_mtime": raw_wn[s],
                    "pagerank": round(raw_pr.get(s, 0.0), 6),
                    "session_prominence": raw_session[s],  # always 0 in v0
                },
                "depends": segs[s]["depends"],
                "path": segs[s]["rel"],
            }
        )

    rows.sort(key=lambda r: (-r["score"], r["slug"]))
    # attach provisional rank (pre-tip); tip fiat rewrites order + scores
    for i, r in enumerate(rows, 1):
        r["rank"] = i
        r["gm_score"] = r["score"]  # preserve pre-fiat GM score
        r["tip_fiat"] = False
    tip_meta = apply_tip_fiat(rows, known_slugs=set(slugs))
    return rows, factor_names, window, tip_meta


def load_tip_ordered_slugs(
    known_slugs: set[str],
    *,
    n_commits: int = TIP_COMMITS,
    top_n: int = TIP_TOP_N,
) -> list[dict]:
    """Segments changed or mentioned in last n_commits, best-first (≤ top_n).

    Order: most recent hit (commit idx 0 = HEAD) → more hits → newer mtime.
    Same definition as try-me tip (kept in sync by shared env knobs).
    """
    if not known_slugs or not git_available():
        return []
    n = max(1, int(n_commits))
    try:
        out = subprocess.check_output(
            [
                "git",
                "-C",
                str(ROOT),
                "log",
                f"-n{n}",
                "--name-only",
                "--pretty=format:%x1e%H%x00%s%x00%b%x00",
                "HEAD",
            ],
            stderr=subprocess.DEVNULL,
            text=True,
            errors="replace",
        )
    except Exception:
        return []

    most_recent: dict[str, int] = {}
    hit_count: dict[str, int] = {}
    commits = 0
    for rec in out.split("\x1e"):
        rec = rec.strip("\n")
        if not rec:
            continue
        parts = rec.split("\x00", 3)
        if len(parts) < 3:
            continue
        _h, subject, body = parts[0], parts[1], parts[2]
        paths_text = parts[3] if len(parts) > 3 else ""
        msg = f"{subject}\n{body}".lower()
        idx = commits
        commits += 1
        hit_this: set[str] = set()
        for line in paths_text.splitlines():
            line = line.strip()
            m = re.search(r"(?:^|/)core/src/([a-z0-9][a-z0-9-]*)\.md$", line)
            if m and m.group(1) in known_slugs:
                hit_this.add(m.group(1))
        for slug in known_slugs:
            if f"#{slug}" in msg or slug in msg:
                hit_this.add(slug)
        for slug in hit_this:
            hit_count[slug] = hit_count.get(slug, 0) + 1
            if slug not in most_recent or idx < most_recent[slug]:
                most_recent[slug] = idx

    if not most_recent:
        return []

    def mtime(slug: str) -> float:
        p = SRC / f"{slug}.md"
        try:
            return p.stat().st_mtime
        except OSError:
            return 0.0

    ordered = sorted(
        most_recent.keys(),
        key=lambda s: (most_recent[s], -hit_count.get(s, 0), -mtime(s), s),
    )[: max(1, int(top_n))]

    return [
        {
            "slug": s,
            "most_recent_commit_idx": most_recent[s],
            "hits_in_window": hit_count.get(s, 0),
            "mtime": mtime(s),
        }
        for s in ordered
    ]


def apply_tip_fiat(rows: list[dict], *, known_slugs: set[str]) -> dict:
    """Force tip segments to ranks 1..k; rest keep GM order from rank k+1.

    Tip scores are set strictly above all non-tip GM scores so score^α
    sampling agrees with the fiat rank list. Original GM score stays in
    gm_score.
    """
    tip_recs = load_tip_ordered_slugs(known_slugs)
    if not tip_recs:
        return {
            "tip_commits": TIP_COMMITS,
            "tip_top_n": TIP_TOP_N,
            "tip_slugs": [],
            "applied": False,
        }

    by_slug = {r["slug"]: r for r in rows}
    tip_kept = [t for t in tip_recs if t["slug"] in by_slug]
    tip_slugs = [t["slug"] for t in tip_kept]
    tip_set = set(tip_slugs)

    rest = [r for r in rows if r["slug"] not in tip_set]
    rest.sort(key=lambda r: (-r.get("gm_score", r["score"]), r["slug"]))

    # Fiat scores: tip #1 highest, stepping down, all > any non-tip score
    max_rest = max((r.get("gm_score", r["score"]) for r in rest), default=0.0)
    # Keep tip scores in a band above max_rest and within [0, 1.5] when possible
    top = max(TIP_FIAT_SCORE_TOP, max_rest + TIP_FIAT_SCORE_STEP * (len(tip_slugs) + 1))
    top = min(top, 1.5) if max_rest < 1.5 else max_rest + TIP_FIAT_SCORE_STEP * (
        len(tip_slugs) + 1
    )

    new_rows: list[dict] = []
    for i, tr in enumerate(tip_kept):
        slug = tr["slug"]
        r = dict(by_slug[slug])
        r["tip_fiat"] = True
        r["tip_fiat_rank"] = i + 1
        r["score"] = round(top - i * TIP_FIAT_SCORE_STEP, 6)
        r["gm_score"] = r.get("gm_score", by_slug[slug]["score"])
        r["tip_most_recent_commit_idx"] = tr.get("most_recent_commit_idx")
        r["tip_hits_in_window"] = tr.get("hits_in_window")
        new_rows.append(r)

    for r in rest:
        r = dict(r)
        r["tip_fiat"] = False
        r["score"] = r.get("gm_score", r["score"])
        new_rows.append(r)

    for i, r in enumerate(new_rows, 1):
        r["rank"] = i

    rows.clear()
    rows.extend(new_rows)

    return {
        "tip_commits": TIP_COMMITS,
        "tip_top_n": TIP_TOP_N,
        "tip_slugs": tip_slugs,
        "applied": True,
        "tip_details": tip_recs[: len(tip_slugs)],
    }


def softmax_weights(
    rows: list[dict], *, temperature: float = DEFAULT_SOFTMAX_T
) -> dict[str, float]:
    """Sampling weights for try-me: p ∝ exp(score / T).

    Polished: calibrate T so top-20 mass is ~50%; optional nucleus sampling;
    separate FE-paragraph weights inside each segment.
    """
    if not rows:
        return {}
    t = max(1e-6, temperature)
    # numerical stability
    m = max(r["score"] for r in rows)
    exps = {r["slug"]: math.exp((r["score"] - m) / t) for r in rows}
    z = sum(exps.values()) or 1.0
    return {s: exps[s] / z for s in exps}


# ── output ────────────────────────────────────────────────────────────────────


def print_table(
    rows: list[dict],
    *,
    top: int | None,
    window_commits: int = DEFAULT_GIT_WINDOW_COMMITS,
    window_actual: int | None = None,
) -> None:
    show = rows if top is None else rows[:top]
    print(
        f"{'Rk':>3}  {'Score':>7}  {'Type':<14}  {'Slug':<48}  "
        f"{'Fresh':>5} {'Churn':>5} {'Ment':>5} {'Pre':>5} {'WN':>5} {'PR':>5}"
    )
    print("-" * 120)
    for r in show:
        fn = r["factors_norm"]
        print(
            f"{r['rank']:3d}  {r['score']:7.4f}  {r['type']:<14}  {r['slug']:<48}  "
            f"{fn.get('freshness', 0):5.2f} "
            f"{fn.get('hotness_churn', 0):5.2f} "
            f"{fn.get('hotness_mention', 0):5.2f} "
            f"{fn.get('preeminence', 0):5.2f} "
            f"{fn.get('working_surface', 0):5.2f} "
            f"{fn.get('pagerank', 0):5.2f}"
        )
    print()
    actual = window_actual if window_actual is not None else window_commits
    n_tip = sum(1 for r in rows if r.get("tip_fiat"))
    print(
        f"n={len(rows)}  geometric-mean rank-CDF × type prior  "
        f"softmax_T={DEFAULT_SOFTMAX_T}  "
        f"git_window=last {window_commits} commits"
        f"{'' if actual == window_commits else f' (actual {actual})'}  "
        f"tip_fiat=ranks 1..{n_tip} (last {TIP_COMMITS} commits)  "
        f"(session_prominence=0 stub)"
    )
    print(
        "Polished: .orient/cache/* memo by HEAD+window+corpus hash; "
        "session EMA; section-level mtime; learned weights."
    )


# Marker applied before [#slug] for free-read priority (outline order).
OUTLINE_STAR = "★ "
DEFAULT_MARK_TOP = 25


def mark_outline(rows: list[dict], top_n: int = DEFAULT_MARK_TOP) -> tuple[int, int]:
    """Star top-N ranked slugs in OUTLINE.md, listed wherever they already sit.

    Order of free-read is OUTLINE order (not rank order). Returns
    (n_starred_in_outline, n_top_missing_from_outline).
    """
    if not OUTLINE.is_file():
        raise FileNotFoundError(f"missing {OUTLINE}")
    top_n = max(1, int(top_n))
    top_slugs = {r["slug"] for r in rows[:top_n]}
    text = OUTLINE.read_text(encoding="utf-8")
    # Strip previous stars immediately before a segment link.
    text = re.sub(r"★\s*(\[#[a-z0-9-]+\])", r"\1", text)

    starred_in_file: set[str] = set()

    def repl(m: re.Match[str]) -> str:
        slug = m.group(1)
        if slug in top_slugs:
            starred_in_file.add(slug)
            return f"{OUTLINE_STAR}[#{slug}]"
        return m.group(0)

    # Only tag the segment-link form used in the outline table Tag column.
    new_text = re.sub(r"\[#([a-z0-9-]+)\]", repl, text)

    # Affordance note — replace prior auto block if present, else insert after
    # the "Every session" paragraph.
    note = (
        f"\n> **Orientation free-read (★).** "
        f"Rows marked ★ are the current high-importance set "
        f"(~top {top_n} by recent/structural rank; refresh with "
        f"`bin/orient-rank --mark-outline`). "
        f"**Most quiz items are drawn from these.** "
        f"Read them in *this* outline order — not by rank score. "
        f"Also free-read whatever you are about to work on, even if unstarred. "
        f"Stars move when importance moves.\n"
    )
    new_text = re.sub(
        r"\n> \*\*Orientation free-read \(★\)\.\*\*.*?\n(?=\n|\Z)",
        "\n",
        new_text,
        count=1,
        flags=re.S,
    )
    anchor = (
        "**Every session:** [`CLAUDE.md`](../CLAUDE.md) · this outline · "
        "[`LEXICON.udon`](../LEXICON.udon)"
    )
    # Find end of that paragraph (next blank line after the Every session line)
    lines = new_text.splitlines(keepends=True)
    out_lines: list[str] = []
    inserted = False
    i = 0
    while i < len(lines):
        out_lines.append(lines[i])
        if not inserted and lines[i].startswith("**Every session:**"):
            # keep consuming until blank line
            i += 1
            while i < len(lines) and lines[i].strip():
                out_lines.append(lines[i])
                i += 1
            out_lines.append(note if note.endswith("\n") else note + "\n")
            if i < len(lines) and lines[i].strip() == "":
                out_lines.append(lines[i])
                i += 1
            inserted = True
            continue
        i += 1
    if not inserted:
        out_lines.append(note if note.endswith("\n") else note + "\n")
    new_text = "".join(out_lines)

    if new_text != OUTLINE.read_text(encoding="utf-8"):
        OUTLINE.write_text(new_text, encoding="utf-8")

    missing = len(top_slugs - starred_in_file)
    return len(starred_in_file), missing


def main() -> None:
    ap = argparse.ArgumentParser(description="Orientation segment hotlist (v0)")
    ap.add_argument("--json", action="store_true", help="JSON to stdout")
    ap.add_argument(
        "--top",
        type=int,
        default=None,
        help="table / mark-outline: top N (default: all for table; "
        f"{DEFAULT_MARK_TOP} for --mark-outline)",
    )
    ap.add_argument(
        "--scores-only",
        action="store_true",
        help="slug\\tscore lines (for try-me / scripts)",
    )
    ap.add_argument(
        "--mark-outline",
        action="store_true",
        help=f"star top-N segments in core/OUTLINE.md (default N={DEFAULT_MARK_TOP})",
    )
    ap.add_argument(
        "--git-window-commits",
        type=int,
        default=None,
        help=f"last N commits for git churn/mention (default {DEFAULT_GIT_WINDOW_COMMITS})",
    )
    ap.add_argument(
        "--write-cache",
        action="store_true",
        default=True,
        help="write .orient/hotlist.json (default on)",
    )
    ap.add_argument(
        "--no-write-cache",
        action="store_true",
        help="skip writing .orient/hotlist.json",
    )
    args = ap.parse_args()

    window_commits = args.git_window_commits
    if window_commits is None:
        env_w = os.environ.get("ORIENT_GIT_WINDOW_COMMITS")
        window_commits = int(env_w) if env_w else DEFAULT_GIT_WINDOW_COMMITS
    window_commits = max(1, int(window_commits))

    t0 = time.time()
    segs = load_segments()
    rows, factor_names, window, tip_meta = compute_scores(
        segs, window_commits=window_commits
    )
    weights = softmax_weights(rows)
    elapsed = time.time() - t0
    window_actual = int(window.get("n_commits") or 0)

    doc = {
        "version": 2,
        "generated_at": int(time.time()),
        "elapsed_sec": round(elapsed, 3),
        "git_window_commits": window_commits,
        "git_window_commits_actual": window_actual,
        "git_head": subprocess.check_output(
            ["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        if git_available()
        else None,
        "factor_names": factor_names,
        "softmax_temperature": DEFAULT_SOFTMAX_T,
        "type_prior": TYPE_PRIOR,
        "aggregate": "geometric_mean",
        "tip_fiat": tip_meta,
        "notes": [
            f"git hotness = among last {window_commits} commits on HEAD "
            f"(actual window size {window_actual})",
            "v0 geometric-mean of rank-CDF factors × type prior; "
            "session_prominence stubbed at 0",
            f"tip fiat: ranks 1..k from last {TIP_COMMITS} commits "
            f"(top {TIP_TOP_N}); GM order continues at k+1",
            "try-me: w ∝ score^α × section × mild_length (α steepens rank; "
            "tip already in scores)",
            "Polished: memoize git+graphs under .orient/cache/ keyed by HEAD+window",
        ],
        "segments": rows,
        "softmax_weights": {s: round(w, 8) for s, w in weights.items()},
    }

    if not args.no_write_cache and args.write_cache:
        HOTLIST_PATH.parent.mkdir(parents=True, exist_ok=True)
        HOTLIST_PATH.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")

    if args.mark_outline:
        n = args.top if args.top is not None else DEFAULT_MARK_TOP
        starred, missing = mark_outline(rows, top_n=n)
        print(
            f"orient-rank: marked ★ on {starred} OUTLINE rows "
            f"(top {n} by rank; {missing} top-ranked missing from OUTLINE)",
            file=sys.stderr,
        )
        # Also print the free-read list in outline order (no scores).
        order: list[str] = []
        seen: set[str] = set()
        for line in OUTLINE.read_text(encoding="utf-8").splitlines():
            for m in re.finditer(r"★\s*\[#([a-z0-9-]+)\]", line):
                s = m.group(1)
                if s not in seen:
                    seen.add(s)
                    order.append(s)
        print("Free-read (OUTLINE order):")
        print("  0. core/OUTLINE.md  (this file — always)")
        for i, s in enumerate(order, 1):
            print(f"  {i}. #{s}")
        return

    if args.scores_only:
        for r in rows:
            print(f"{r['slug']}\t{r['score']}")
        return

    if args.json:
        print(json.dumps(doc, indent=2))
        return

    print_table(
        rows,
        top=args.top,
        window_commits=window_commits,
        window_actual=window_actual,
    )
    if not args.no_write_cache:
        print(f"wrote {HOTLIST_PATH}  ({elapsed:.2f}s)", file=sys.stderr)

if __name__ == "__main__":
    main()
