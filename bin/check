#!/usr/bin/env bash
# Epistemic gate for world-law code (doc/toolchain.md).
# Tests + clippy determinism bans. Not full-workspace -D warnings yet.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== cargo test -p vivarium-world --lib =="
cargo test -p vivarium-world --lib

echo "== cargo test -p vivarium-world --test cli_admission =="
cargo test -p vivarium-world --test cli_admission

echo "== check-decision-refs (FORMAT §5.1 citation form) =="
bin/check-decision-refs

echo "== check-provenance (cohort digests, git revisions, capture embeds must resolve) =="
bin/check-provenance

echo "== null-space gate (examples/null_space_gate — can-fail, exits nonzero on a spurious zero mode) =="
cargo run -p vivarium-world --release --example null_space_gate --quiet

echo "== cargo clippy -p vivarium-world --lib (determinism bans deny) =="
cargo clippy -p vivarium-world --lib -- \
  -D clippy::disallowed_methods \
  -D clippy::disallowed_types

echo "bin/check: ok"
