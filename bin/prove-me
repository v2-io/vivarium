#!/usr/bin/env python3
"""
Grade (or inspect) a try-me orientation test.

core/src stays sealed until grading finishes (then unsealed).

Commands
--------
  bin/prove-me              Show open quiz + answer format (or expired/missing status).
                            Never grades. May unseal if the live test is expired.
  bin/prove-me --help       Help only — never touches seal / test / pass files.
  bin/prove-me --template   Refresh .orient/answers.stub.udon from the open test.
  bin/prove-me --ready FILE Grade answers from FILE (− = stdin).

Answers — vanilla udon (no advanced syntax)
-------------------------------------------
  |answer[P1]
    completion prose indented under the element…
    more lines ok

  |answer[P2]
    …

  Full unit text, middle only, or middle+end — all match when they normalize equal.
  `;` comments are ignored. Recognition is line/indent only (same spirit as
  DECISIONS.decision-log.udon greps — not a full udon engine).

Pass bars (default n=5):
  5/5     FULL — unlimited commits while compaction_gen matches
  3–4/5   ONE-TIME — one commit; promise to free-read missed sections
  <3/5    fail — burn test, re-try-me

Soft reject (exit 2): empty/format/misunderstanding while deadline remains —
does NOT burn, does NOT unseal; fix the file and re --ready.

On pass: AES-GCM + HMAC pass under .orient/passes/; print orient:<session_id>.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ORIENT = ROOT / ".orient"
PASSES = ORIENT / "passes"
TEST_PATH = ORIENT / "test.jsonl"
ANSWERS_STUB = ORIENT / "answers.stub.udon"
QUIZ_UDON = ORIENT / "quiz.udon"
BURNED = ORIENT / "burned"
SEAL_LIST = ORIENT / "sealed_paths"
SALT = "vivarium-orient-v2"


def _udon_quiz():
    import importlib.util

    spec = importlib.util.spec_from_file_location(
        "orient_udon_quiz", ROOT / "bin" / "orient-udon-quiz.py"
    )
    assert spec and spec.loader
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

MIN_PARTIAL = int(os.environ.get("ORIENT_MIN_PARTIAL", "3"))
# Soft-reject unless this many expected |answer bodies look like real attempts.
MIN_ATTEMPT = int(os.environ.get("ORIENT_MIN_ATTEMPT", "3"))
MIN_BODY_CHARS = int(os.environ.get("ORIENT_MIN_BODY_CHARS", "5"))

# Top-level |answer[Pn]  (optional same-line attrs ignored after ])
# No \b after ] — ] is non-word; \b would fail at EOL / before space.
ANSWER_OPEN = re.compile(r"^\|answer\[(P\d+)\](?:\s|:|$)", re.I)
# Any other column-0 element ends the previous answer body
OTHER_ELEMENT = re.compile(r"^\|[A-Za-z_]")

HELP = """prove-me — inspect or grade the open orientation quiz

  bin/prove-me                 Print open quiz as vanilla udon (no grade)
  bin/prove-me --help          This help — never seals, unseals, or grades
  bin/prove-me --template      Refresh .orient/quiz.udon + answers.stub.udon
  bin/prove-me --ready FILE    Submit answers from FILE (− for stdin)

Quiz and answers are both vanilla udon (see .orient/quiz.udon after try-me):

  |quiz[…]
    |item[P1]
      :slug …
      :start "first words…"
      :end "last words…"     ; when the completion is long

  |answer[P1]
    your completion after :start…

After a pass, put this in the commit message:
  orient:<session_id printed by a successful --ready>

Pass grades (default 5 items):
  5/5     unlimited commits while this session's compaction gen matches
  3/5–4/5 one-time commit + promise to free-read what you missed
  <3/5    fail — free-read, bin/try-me again

Soft reject (exit 2): empty/wrong format, or fewer than 3 substantial
answers (>5 chars each) — test stays live and sealed while time remains.

One active quiz per checkout. See ORIENT.md.
"""


def die(msg: str, code: int = 1) -> None:
    print(f"prove-me: {msg}", file=sys.stderr)
    sys.exit(code)


def sha256_text(s: str) -> str:
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def normalize(s: str) -> str:
    s = s.strip().lower()
    s = re.sub(r"\s+", " ", s)
    s = re.sub(r"[^\w\s]", "", s)
    return s.strip()


def unseal() -> None:
    if not SEAL_LIST.is_file():
        for p in (ROOT / "core" / "src").rglob("*.md"):
            if p.exists() and not os.access(p, os.R_OK):
                try:
                    p.chmod(0o644)
                except OSError:
                    pass
        return
    for line in SEAL_LIST.read_text(encoding="utf-8").splitlines():
        p = Path(line)
        if p.exists():
            try:
                p.chmod(0o644)
            except OSError:
                pass
    SEAL_LIST.unlink(missing_ok=True)


def _dedent_body(lines: list[str]) -> str:
    """Strip common leading indent; drop pure-comment and empty-only noise."""
    # Keep structure: comments that are whole lines (`; …` after indent) out.
    kept: list[str] = []
    for ln in lines:
        raw = ln.rstrip("\n")
        stripped = raw.lstrip()
        if not stripped:
            kept.append("")
            continue
        if stripped.startswith(";"):
            continue  # udon comment owns the line
        kept.append(raw)
    # drop leading/trailing blank lines
    while kept and not kept[0].strip():
        kept.pop(0)
    while kept and not kept[-1].strip():
        kept.pop()
    if not kept:
        return ""
    indents = [
        len(ln) - len(ln.lstrip(" \t"))
        for ln in kept
        if ln.strip()
    ]
    pad = min(indents) if indents else 0
    body = "\n".join(ln[pad:] if len(ln) >= pad else ln for ln in kept)
    return body.strip()


def parse_answers(text: str) -> dict[str, str]:
    """Vanilla udon answers: column-0 |answer[Pn] + indented prose body.

    Same recognition level as DECISIONS greps — not a full udon engine.
    Optional same-line attributes after ] are ignored.
    """
    if not text or not text.strip():
        return {}

    out: dict[str, str] = {}
    current: str | None = None
    buf: list[str] = []

    def flush() -> None:
        nonlocal current, buf
        if current is None:
            return
        body = _dedent_body(buf)
        if body:
            out[current] = body
        current = None
        buf = []

    for line in text.splitlines():
        # Column-0 answer open
        if line.startswith("|"):
            m = ANSWER_OPEN.match(line)
            if m:
                flush()
                current = m.group(1).upper()
                buf = []
                continue
            # Another top-level element ends the current body
            if current is not None and OTHER_ELEMENT.match(line):
                flush()
                # ignore unknown top-level; do not start a new answer
                continue
        if current is not None:
            # Body: blank, indented, or (lenient) non-pipe continuation
            if (
                not line.strip()
                or line[0] in " \t"
                or not line.startswith("|")
            ):
                buf.append(line)
            else:
                flush()
    flush()
    return out


def _looks_like_placeholder(body: str) -> bool:
    b = body.strip()
    if not b:
        return True
    low = b.lower()
    if low in {"...", "…", "todo", "tbd", "pass", "answer", "your completion here"}:
        return True
    if low.startswith("replace this") or low.startswith("fill in"):
        return True
    # Still the quiz file / attribute dump, not a completion
    if re.match(r"^:(start|end|slug|section|words)\b", low):
        return True
    if low.startswith("|item[") or low.startswith("|quiz[") or low.startswith("|answer["):
        return True
    return False


def _substantial_answers(
    given: dict[str, str],
    expected: set[str],
) -> dict[str, str]:
    """Expected-id bodies that look like a real attempt (not stub noise)."""
    out: dict[str, str] = {}
    for k, v in given.items():
        if k.upper() not in expected:
            continue
        body = (v or "").strip()
        if len(body) <= MIN_BODY_CHARS:
            continue
        if _looks_like_placeholder(body):
            continue
        out[k] = v
    return out


def soft_reject_reason(
    raw: str,
    given: dict[str, str],
    expected_ids: list[str],
) -> str | None:
    """If this looks like format/parse confusion or an incomplete draft
    (not a real graded attempt), return a human reason. Caller keeps the
    test live (no burn/unseal) while deadline remains.

    Returns None when the submit is a real graded attempt: at least
    MIN_ATTEMPT expected |answer bodies with length > MIN_BODY_CHARS.
    """
    raw = raw or ""
    raw_stripped = raw.strip()
    expected = {e.upper() for e in expected_ids}
    need = min(MIN_ATTEMPT, len(expected) or MIN_ATTEMPT)

    substantial = _substantial_answers(given, expected)
    if len(substantial) >= need:
        return None  # graded attempt — score it

    # --- below: fewer than `need` real bodies ---

    if not raw_stripped:
        return "empty submit (no file content)"

    # Only comments / blanks
    non_comment = [
        ln
        for ln in raw.splitlines()
        if ln.strip() and not ln.lstrip().startswith(";")
    ]
    if not non_comment:
        return "file is only ; comments / blank lines (stub unfilled)"

    # Classic ad-hoc / JSON (pre-udon or confused)
    if re.search(r'(?m)^(P\d+)\s*[:|]', raw) or raw_stripped.startswith("{"):
        return (
            "looks like legacy P1: / JSON, not vanilla udon |answer[Pn] blocks"
        )

    # Filled the quiz document instead of the answers stub
    if re.search(r"(?m)^\s*\|quiz\[", raw) or re.search(
        r"(?m)^\s*\|item\[P\d+\]", raw
    ):
        return (
            "looks like the quiz file (|quiz / |item) — "
            "fill |answer[Pn] in answers.stub.udon instead"
        )

    # Close misspellings of the element name
    if re.search(r"(?m)^\s*\|(answers?|ans|a|response|item)\[P\d+\]", raw, re.I):
        if not re.search(r"(?m)^\s*\|answer\[P\d+\]", raw, re.I):
            return (
                "saw a near-miss element name — need column-0 |answer[P1] "
                "(exact spelling), indented body under it"
            )

    # Headers present but bodies empty / short / placeholder
    headers = re.findall(r"(?m)^\s*\|answer\[(P\d+)\]", raw, re.I)
    if headers and not substantial:
        return (
            f"found |answer[…] headers ({', '.join(h.upper() for h in headers)}) "
            "but no substantial completion body under them — "
            "indent the prose under each |answer[Pn]"
        )

    # Some real bodies, but not enough to count as "ready"
    if substantial:
        have = len(substantial)
        return (
            f"only {have} substantial answer(s) "
            f"(need at least {need} with more than {MIN_BODY_CHARS} characters) — "
            "not grading yet; finish more items and re-submit. "
            "Test stays live."
        )

    # Bodies only under wrong ids
    if given and not substantial:
        wrong_keys = sorted(k for k in given if k.upper() not in expected)
        if wrong_keys:
            return (
                f"parsed keys {wrong_keys} but expected {sorted(expected)} — "
                "use |answer[P1] … matching the quiz"
            )
        return "only placeholder / too-short bodies under |answer[…]"

    if not given:
        return (
            "no |answer[Pn] blocks parsed — expected vanilla udon:\n"
            "    |answer[P1]\n"
            "      completion after :start…\n"
            "  See .orient/quiz.udon and .orient/answers.stub.udon"
        )

    return "no usable answers for the open quiz items (format / empty / incomplete)"


def variants(prefix: str, answer: str, suffix: str, last_hint: str) -> list[str]:
    """Honest format confusions: middle / rest / full / with anchors."""
    a = answer.strip()
    cands = [a, normalize(a)]
    if prefix:
        cands.append(f"{prefix} {a}")
        cands.append(normalize(f"{prefix} {a}"))
    if suffix and not a.endswith(suffix):
        cands.append(f"{a} {suffix}")
        cands.append(normalize(f"{a} {suffix}"))
        if prefix:
            cands.append(f"{prefix} {a} {suffix}")
            cands.append(normalize(f"{prefix} {a} {suffix}"))
    if last_hint and not a.endswith(last_hint):
        cands.append(f"{a} {last_hint}")
        cands.append(normalize(f"{a} {last_hint}"))
    return cands


def match_item(item: dict, raw: str) -> bool:
    keys = {
        item.get("answer_sha256", ""),
        item.get("answer_sha256_middle", ""),
        item.get("answer_sha256_full", ""),
        item.get("answer_sha256_prefix_rest", ""),
    }
    keys.discard("")
    for v in variants(
        item.get("prefix", ""),
        raw,
        item.get("suffix", ""),
        item.get("last_word_hint", ""),
    ):
        if sha256_text(normalize(v)) in keys:
            return True
        if sha256_text(v) in keys:
            return True
    return False


def load_test() -> dict | None:
    if not TEST_PATH.is_file():
        return None
    return json.loads(TEST_PATH.read_text(encoding="utf-8"))


def burned_ids() -> set[str]:
    if not BURNED.is_file():
        return set()
    return {ln.strip() for ln in BURNED.read_text().splitlines() if ln.strip()}


def burn(test_id: str) -> None:
    BURNED.parent.mkdir(parents=True, exist_ok=True)
    with BURNED.open("a", encoding="utf-8") as f:
        f.write(test_id + "\n")


def show_quiz(doc: dict) -> None:
    """Print the open quiz as vanilla udon (from disk if present, else rebuild)."""
    items = doc.get("items") or []
    print(
        f"prove-me: open test_id={doc.get('test_id')}  "
        f"items={len(items)}  stub={ANSWERS_STUB}",
        file=sys.stderr,
    )
    # Prefer the written quiz.udon so stdout matches what try-me left on disk.
    if QUIZ_UDON.is_file():
        text = QUIZ_UDON.read_text(encoding="utf-8")
        sys.stdout.write(text if text.endswith("\n") else text + "\n")
        return
    uq = _udon_quiz()
    sys.stdout.write(
        uq.format_quiz_udon(
            items,
            test_id=str(doc.get("test_id", "")),
            deadline=doc.get("deadline", ""),
            git_head=str(doc.get("git_head") or ""),
            stub_path=".orient/answers.stub.udon",
            n=doc.get("n"),
        )
    )


def write_template(doc: dict) -> None:
    items = doc.get("items") or []
    uq = _udon_quiz()
    ANSWERS_STUB.parent.mkdir(parents=True, exist_ok=True)
    ANSWERS_STUB.write_text(
        uq.format_answers_stub(items, test_id=str(doc.get("test_id") or "")),
        encoding="utf-8",
    )
    # Keep quiz.udon in sync when regenerating the stub
    QUIZ_UDON.write_text(
        uq.format_quiz_udon(
            items,
            test_id=str(doc.get("test_id", "")),
            deadline=doc.get("deadline", ""),
            git_head=str(doc.get("git_head") or ""),
            stub_path=".orient/answers.stub.udon",
            n=doc.get("n"),
        ),
        encoding="utf-8",
    )
    print(f"prove-me: wrote {ANSWERS_STUB}", file=sys.stderr)
    print(f"prove-me: wrote {QUIZ_UDON}", file=sys.stderr)


def cmd_status() -> None:
    """Default: show quiz or explain how to get one. Never grade."""
    doc = load_test()
    if doc is None:
        unseal()  # belt: clear any stray seal
        print("prove-me: no open test (.orient/test.jsonl missing).")
        print("  Free-read first (see ORIENT.md / OUTLINE ★ rows), then:")
        print("    bin/try-me")
        print_format_help()
        return

    test_id = doc.get("test_id", "")
    now = int(time.time())
    if test_id in burned_ids():
        unseal()
        TEST_PATH.unlink(missing_ok=True)
        print(f"prove-me: test_id {test_id} is burned.")
        print("  bin/try-me   # new quiz")
        return

    deadline = int(doc.get("deadline", 0))
    if now > deadline:
        burn(test_id)
        unseal()
        TEST_PATH.unlink(missing_ok=True)
        print(
            f"prove-me: test {test_id} expired (deadline {deadline}). "
            "core/src unsealed."
        )
        print("  Free-read if needed, then: bin/try-me")
        return

    expect_mac = sha256_text(
        f"{SALT}:{test_id}:{doc['deadline']}:{doc['git_head']}"
    )
    if doc.get("mac") != expect_mac:
        unseal()
        print("prove-me: test mac mismatch — discard and bin/try-me again")
        return

    show_quiz(doc)


def cmd_ready(ans_source: str) -> None:
    if ans_source == "-":
        raw_answers = sys.stdin.read()
    else:
        p = Path(ans_source)
        if not p.is_file():
            die(f"answers file not found: {ans_source}")
        raw_answers = p.read_text(encoding="utf-8")

    doc = load_test()
    if doc is None:
        unseal()
        die("no .orient/test.jsonl — run bin/try-me first")

    test_id = doc["test_id"]
    now = int(time.time())

    if test_id in burned_ids():
        unseal()
        die(f"test_id {test_id} is burned — generate a new test: bin/try-me")

    if now > int(doc.get("deadline", 0)):
        burn(test_id)
        unseal()
        TEST_PATH.unlink(missing_ok=True)
        die("test deadline expired — bin/try-me again")

    expect_mac = sha256_text(
        f"{SALT}:{test_id}:{doc['deadline']}:{doc['git_head']}"
    )
    if doc.get("mac") != expect_mac:
        unseal()
        die("test mac mismatch — regenerate with bin/try-me")

    items = doc["items"]
    expected_ids = [it["id"] for it in items]
    n = len(items)
    given = parse_answers(raw_answers)

    # Soft reject: format / empty / misunderstanding — keep seal + test while
    # deadline remains. Hard fail (burn) only after a real graded attempt.
    soft = soft_reject_reason(raw_answers, given, expected_ids)
    if soft:
        left = int(doc.get("deadline", 0)) - now
        print(f"prove-me: not graded — {soft}", file=sys.stderr)
        print(
            "prove-me: test still LIVE "
            f"(test_id={test_id}, ~{max(0, left)}s left, core/src still sealed).",
            file=sys.stderr,
        )
        print(
            "  Fix the answers file, then:  bin/prove-me --ready <file>\n"
            "  Re-print quiz:               bin/prove-me\n"
            "  Format help:                 bin/prove-me --help",
            file=sys.stderr,
        )
        sys.exit(2)

    correct = 0
    wrong = 0
    missed: list[dict] = []
    for it in items:
        iid = it["id"]
        if iid not in given:
            print(f"prove-me: FAIL {iid} — missing", file=sys.stderr)
            wrong += 1
            missed.append(it)
            continue
        if match_item(it, given[iid]):
            print(f"prove-me: ok   {iid}")
            correct += 1
        else:
            print(f"prove-me: FAIL {iid} — hash mismatch", file=sys.stderr)
            wrong += 1
            missed.append(it)

    print(f"prove-me: score {correct}/{n} (wrong={wrong})", file=sys.stderr)

    full = wrong == 0 and correct == n
    partial = (not full) and correct >= MIN_PARTIAL
    passed = full or partial

    if not passed:
        # Real graded fail — burn and unseal
        unseal()
        print("prove-me: core/src unsealed", file=sys.stderr)
        burn(test_id)
        TEST_PATH.unlink(missing_ok=True)
        print(
            f"\nNeed at least {MIN_PARTIAL}/{n} correct "
            f"(you had {correct}/{n}). Re-orient, then `bin/try-me` again.\n",
            file=sys.stderr,
        )
        sys.exit(1)

    unseal()
    print("prove-me: core/src unsealed", file=sys.stderr)

    sess = json.loads(
        __import__("subprocess")
        .check_output([str(ROOT / "bin" / "orient-session.py")], text=True)
    )
    if not sess.get("ok"):
        die(
            "cannot bind pass to session/compaction "
            f"({sess.get('error', 'unknown')}). "
            "Run under an active Grok/Claude session."
        )

    sid = sess["session_id"]
    n_bound = sess.get("boundary_count", sess.get("segment_count"))

    missed_refs = []
    for it in missed:
        missed_refs.append(
            {
                "id": it.get("id"),
                "slug": it.get("slug"),
                "path": it.get("path"),
                "breadcrumb": it.get("breadcrumb"),
            }
        )

    if full:
        uses_left = -1
        provisional = False
        kind = "FULL"
    else:
        uses_left = 1
        provisional = True
        kind = "ONE-TIME"

    pass_doc = {
        "version": 7,
        "ts": now,
        "test_id": test_id,
        "provisional": provisional,
        "one_time": uses_left == 1,
        "score": f"{correct}/{n}",
        "correct": correct,
        "n": n,
        "missed": missed_refs,
        "harness": sess.get("harness"),
        "session_id": sid,
        "compaction_gen": sess["compaction_gen"],
        "boundary_count": n_bound,
        "uses_left": uses_left,
    }
    import importlib.util

    _spec = importlib.util.spec_from_file_location(
        "orient_crypto", ROOT / "bin" / "orient-crypto.py"
    )
    assert _spec and _spec.loader
    _crypto = importlib.util.module_from_spec(_spec)
    _spec.loader.exec_module(_crypto)
    _crypto.write_pass(sid, pass_doc, ROOT)
    (ORIENT / "pass").unlink(missing_ok=True)
    (PASSES / f"{sid}.json").unlink(missing_ok=True)

    burn(test_id)
    TEST_PATH.unlink(missing_ok=True)

    print(file=sys.stderr)
    print(f"prove-me: {kind} PASS ({correct}/{n})", file=sys.stderr)
    print(
        f"prove-me: bound to harness={sess.get('harness')} "
        f"session={sid[:8]}… "
        f"gen={sess['compaction_gen'][:12]}… "
        f"boundaries={n_bound}",
        file=sys.stderr,
    )
    if full:
        print(
            "prove-me: unlimited commits while this session's compaction gen matches",
            file=sys.stderr,
        )
    else:
        print(
            "prove-me: ONE-TIME commit token — after that commit, re-prove "
            "(or free-read the missed material first).",
            file=sys.stderr,
        )
        print(
            "prove-me: By accepting this pass you promise to free-read the "
            "sections you missed before relying on them:",
            file=sys.stderr,
        )
        for m in missed_refs:
            crumb = m.get("breadcrumb") or m.get("slug") or "?"
            slug = m.get("slug") or "?"
            path = m.get("path") or f"core/src/{slug}.md"
            print(f"  • {m.get('id')}: #{slug}  —  {crumb}", file=sys.stderr)
            print(f"      {path}", file=sys.stderr)
    print(
        "prove-me: put this exact token in your commit message "
        "(dies on compact for that session):",
        file=sys.stderr,
    )
    print(file=sys.stderr)
    print(f"orient:{sid}")
    print(file=sys.stderr)


def main(argv: list[str] | None = None) -> None:
    argv = list(sys.argv[1:] if argv is None else argv)

    if not argv or argv == ["status"]:
        cmd_status()
        return

    if argv[0] in ("-h", "--help", "help"):
        print(HELP)
        return

    if argv[0] in ("--template", "template"):
        doc = load_test()
        if doc is None:
            die("no open test — bin/try-me first")
        write_template(doc)
        return

    if argv[0] in ("--ready", "ready"):
        if len(argv) < 2:
            die("usage: bin/prove-me --ready FILE   (− for stdin)")
        try:
            cmd_ready(argv[1])
        except Exception:
            unseal()
            raise
        return

    # Backward-compat: bare path was "grade this file" — keep it, but warn.
    if len(argv) == 1 and not argv[0].startswith("-"):
        print(
            "prove-me: note — prefer `bin/prove-me --ready FILE` "
            "(bare path is accepted for now)",
            file=sys.stderr,
        )
        try:
            cmd_ready(argv[0])
        except Exception:
            unseal()
            raise
        return

    die(f"unknown args: {argv!r}\n\n{HELP}")


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
