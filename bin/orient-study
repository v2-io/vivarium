#!/usr/bin/env bash
# Record a study commitment over the Level-A corpus.
# Does NOT grant commit rights — only freezes digests for a later closed-book prove.
set -euo pipefail
# shellcheck source=orient-lib.sh
source "$(cd "$(dirname "$0")" && pwd)/orient-lib.sh"

if [[ "${1:-}" == "--list" || "${1:-}" == "-l" ]]; then
  echo "Level-A corpus (read each file fully before bin/orient-study):"
  for p in "${ORIENT_REQUIRED[@]}"; do
    f="$ORIENT_ROOT/$p"
    if [[ -f "$f" ]]; then
      bytes=$(wc -c <"$f" | tr -d ' ')
      echo "  $p  ($bytes bytes)"
    else
      echo "  $p  MISSING"
    fi
  done
  echo
  echo "Corpus hash now: $(orient_corpus_hash)"
  exit 0
fi

mkdir -p "$ORIENT_DIR"
corpus=$(orient_corpus_hash)
{
  echo "version=1"
  echo "ts=$(date +%s)"
  echo "corpus=$corpus"
  echo "files<<"
  for p in "${ORIENT_REQUIRED[@]}"; do
    f="$ORIENT_ROOT/$p"
    echo "${p}=$(orient_sha_file "$f")"
  done
  echo ">>"
} >"$STUDY_FILE"

echo "orient-study: recorded corpus=$corpus"
echo "orient-study: next — ensure you have READ every file above, then:"
echo "             bin/orient-prove"
echo "orient-study: (prove seals files so you cannot re-open them mid-quiz)"
